<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Package consumed by Foundation.API (local feed: C:\Decco\localNuget).
    SemVer: a removal or rename breaks 1.x/2.x consumers at compile time → MAJOR.
    Additive-only change → MINOR. Never overwrite a version that was already consumed:
    NuGet keeps it in the global cache and the consumer would keep using the old one.
  -->
  <PropertyGroup>
    <PackageId>Decco.Contracts</PackageId>
    <Version>3.0.0</Version>
    <Authors>vohdril</Authors>
    <Description>Decco.API contracts: envelope (RequestBase/ResponseBase/PagedResponse/PageRequest) and DeccoDB DTOs. Study sandbox, fictional data.</Description>
    <PackageReleaseNotes>3.0.0 — English normalization of structural names: OperacaoFiltroDto → OperacaoFilterDto. XML docs in English. Domain names that mirror the DeccoDB schema are unchanged. 2.0.0 — Instalacao and Operacao: LaboratorioDto removed (now InstalacaoDto of type LABORATORIO), AnomaliaDto.SitioContencao removed (now InstalacaoContencaoId/Codigo/Nome), classification Ids added to AnomaliaDto, new InstalacaoDto, CatTipoInstalacaoDto, OperacaoDto, CatOperacaoDto and PageRequest.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/vohdril/Decco.API</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>decco;contracts;envelope</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- DTOs without <summary> are self-explanatory; do not turn that into a warning. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
