# Fonte de dados do front. Copie para `.env` e ajuste conforme o cenário.
#   mock  → dados em memória (padrão); desenvolve o front SEM back-end de pé.
#   live  → chama a Decco.API / Foundation.API (precisa do back rodando + CORS).
# Dica: dá para alternar em runtime pelo seletor DADOS no topo da tela
# (grava em localStorage e recarrega) — o .env é só o default estático.
VITE_DATA_SOURCE=mock

# Base URL da API quando VITE_DATA_SOURCE=live (Foundation.API / Decco.API).
VITE_API_BASE_URL=http://localhost:5175
